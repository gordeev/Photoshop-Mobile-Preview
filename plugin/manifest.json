{
  "manifestVersion": 5,
  "id": "com.mobilepreview.ps",
  "name": "Mobile Preview",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "24.4.0"
  },
  "requiredPermissions": {
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mobilePreviewPanel",
      "label": {
        "default": "Mobile Preview"
      },
      "minimumSize": {
        "width": 230,
        "height": 260
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 340
      },
      "preferredFloatingSize": {
        "width": 260,
        "height": 340
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-23.png",
          "scale": [
            1
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/icon-46.png",
          "scale": [
            2
          ]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-48.png",
      "scale": [
        1
      ]
    },
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-96.png",
      "scale": [
        2
      ]
    }
  ]
}
